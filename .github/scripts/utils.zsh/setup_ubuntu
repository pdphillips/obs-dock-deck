autoload -Uz log_error log_status log_info log_warning mkcd

if (( ! ${+project_root} )) {
  log_error "'project_root' not set. Please set before running ${0}."
  return 2
}

if (( ! ${+target} )) {
  log_error "'target' not set. Please set before running ${0}."
  return 2
}

pushd ${project_root}

typeset -g QT_VERSION

local -a apt_args=(
  ${CI:+-y}
  --no-install-recommends
)
if (( _loglevel == 0 )) apt_args+=(--quiet)

if (( ! (${skips[(Ie)all]} + ${skips[(Ie)deps]}) )) {
  log_group 'Installing obs-studio build dependencies...'

  local suffix
  if [[ ${CPUTYPE} != "${target##*-}" ]] {
    local -A arch_mappings=(
      aarch64 arm64
      x86_64 amd64
    )

    suffix=":${arch_mappings[${target##*-}]}"

    sudo apt-get install ${apt_args} gcc-${${target##*-}//_/-}-linux-gnu g++-${${target##*-}//_/-}-linux-gnu
  }

  # Launchpad's PPA intermittently answers HTTP 503. When that happens apt
  # silently falls back to Ubuntu's own obs-studio package, which has no
  # libobs CMake config, and configure fails later with a confusing error.
  # Retry until the PPA's build is the install candidate, or fail clearly.
  local obs_candidate=''
  local -i attempt
  local ppa_source
  for attempt ({1..6}) {
    sudo add-apt-repository --yes --no-update ppa:obsproject/obs-studio || true
    # Ubuntu 26.04 cloud images (GitHub's runners included) prefer amd64v3
    # packages, and the OBS PPA's amd64v3 index is empty, so apt never sees
    # its obs-studio. Pin the PPA source to the baseline architecture.
    for ppa_source (/etc/apt/sources.list.d/obsproject-ubuntu-obs-studio-*.sources(N)) {
      if ! grep -q '^Architectures:' ${ppa_source}; then
        sudo sed -i "/^Types:/a Architectures: $(dpkg --print-architecture)" ${ppa_source}
      fi
    }
    sudo apt-get -o Acquire::Retries=3 update || true
    obs_candidate="$(apt-cache policy obs-studio | awk '/Candidate:/ { print $2 }')"
    if [[ ${obs_candidate} == *obsproject* ]] break
    log_warning "OBS PPA not reachable yet (candidate: '${obs_candidate}'), retry ${attempt}/6..."
    sleep $(( attempt * 15 ))
  }
  if [[ ${obs_candidate} != *obsproject* ]] {
    log_error "Could not get obs-studio from ppa:obsproject/obs-studio (candidate: '${obs_candidate}')."
    return 2
  }

  # The PPA's download server also returns 503 now and then; retry the install.
  for attempt ({1..5}) {
    if sudo apt-get -o Acquire::Retries=5 install ${apt_args} \
      build-essential \
      libgles2-mesa-dev \
      libsimde-dev \
      obs-studio=${obs_candidate}; then
      break
    fi
    if (( attempt == 5 )) {
      log_error 'Installing obs-studio from the OBS PPA kept failing.'
      return 2
    }
    log_warning "obs-studio download failed, retry ${attempt}/5..."
    sleep $(( attempt * 15 ))
  }

  local -a _qt_packages=()

  if (( QT_VERSION == 5 )) {
    _qt_packages+=(
      qtbase5-dev${suffix}
      libqt5svg5-dev${suffix}
      qtbase5-private-dev${suffix}
      libqt5x11extras5-dev${suffix}
    )
  } else {
    _qt_packages+=(
      qt6-base-dev${suffix}
      libqt6svg6-dev${suffix}
      qt6-base-private-dev${suffix}
    )
  }

  sudo apt-get install ${apt_args} ${_qt_packages}
  log_group
}
